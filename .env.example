# Copiad este archivo a .env.local para desarrollo local y configurad las
# mismas variables en Vercel (Project Settings → Environment Variables).
# NUNCA escribáis valores reales en este archivo ni en ningún archivo que
# se suba a Git.

# Stripe: clave live en Production y clave test en Preview y Development.
STRIPE_SECRET_KEY=

# Vercel Blob — autenticación mediante OIDC (recomendado por Vercel desde
# que las Signed URLs son GA). NO se usa BLOB_READ_WRITE_TOKEN.
# Ambas variables las gestiona Vercel automáticamente en despliegues al
# conectar un Blob store al proyecto (Storage → Blob → Connect):
#   - VERCEL_OIDC_TOKEN: token OIDC de corta duración, rotado por Vercel.
#     NUNCA lo leáis ni lo paséis a mano al SDK.
#   - BLOB_STORE_ID: id del store privado.
# Para desarrollo local, ejecutad una vez `vercel env pull` para traer
# ambas variables (el SDK las renueva solo después).
VERCEL_OIDC_TOKEN=
BLOB_STORE_ID=

# Dominio base de la web, usado para construir success_url/cancel_url de
# Stripe Checkout. Opcional: si no se define, el código usa
# https://6eight-web.vercel.app por defecto.
SITE_URL=

# El checkout usa VERCEL_URL como retorno cuando VERCEL_ENV es preview.
