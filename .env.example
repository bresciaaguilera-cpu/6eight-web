# Copiad este archivo a .env.local para desarrollo local y configurad las
# mismas variables en Vercel (Project Settings → Environment Variables).
# NUNCA escribáis valores reales en este archivo ni en ningún archivo que
# se suba a Git.

# Stripe — clave secreta de modo TEST (empieza por sk_test_...).
# NUNCA la clave live (sk_live_...) mientras estemos probando.
STRIPE_SECRET_KEY=

# Vercel Blob — token de lectura/escritura del store PRIVADO donde viven
# los PDF de los productos. Vercel lo genera automáticamente al conectar
# un Blob store al proyecto (Storage → Blob → Connect).
BLOB_READ_WRITE_TOKEN=

# Dominio base de la web, usado para construir success_url/cancel_url de
# Stripe Checkout. Opcional: si no se define, el código usa
# https://6eight-web.vercel.app por defecto.
SITE_URL=
